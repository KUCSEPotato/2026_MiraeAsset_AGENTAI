@prefix fin: <https://miraeasset.com/ontology/financial-product#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

fin:FieldAUM a owl:NamedIndividual ; fin:canonicalName "product.aum" ; fin:canonicalField "product.aum" ; fin:conceptCategory "field" ; fin:alias "AUM", "순자산", "운용규모" .
fin:FieldExpenseRatio a owl:NamedIndividual ; fin:canonicalName "product.expense_ratio" ; fin:canonicalField "product.expense_ratio" ; fin:conceptCategory "field" ; fin:alias "보수", "총보수", "expense ratio" .
fin:FieldRegion a owl:NamedIndividual ; fin:canonicalName "product.region" ; fin:canonicalField "product.region" ; fin:conceptCategory "field" ; fin:alias "지역", "투자지역" .
fin:FieldAssetType a owl:NamedIndividual ; fin:canonicalName "product.asset_type" ; fin:canonicalField "product.asset_type" ; fin:conceptCategory "field" ; fin:alias "자산군", "자산유형" .
fin:FieldProductType a owl:NamedIndividual ; fin:canonicalName "product.product_type" ; fin:canonicalField "product.product_type" ; fin:conceptCategory "field" ; fin:alias "상품유형", "상품종류" .
fin:FieldPrice a owl:NamedIndividual ; fin:canonicalName "product.price" ; fin:canonicalField "product.price" ; fin:conceptCategory "field" ; fin:alias "가격", "종가", "현재가" .
fin:FieldNAV a owl:NamedIndividual ; fin:canonicalName "product.nav" ; fin:canonicalField "product.nav" ; fin:conceptCategory "field" ; fin:alias "NAV", "기준가" .
fin:FieldTicker a owl:NamedIndividual ; fin:canonicalName "product.ticker" ; fin:canonicalField "product.ticker" ; fin:conceptCategory "field" ; fin:alias "티커" .
fin:FieldISIN a owl:NamedIndividual ; fin:canonicalName "product.isin" ; fin:canonicalField "product.isin" ; fin:conceptCategory "field" ; fin:alias "ISIN", "종목번호" .
fin:FieldEtpDistributionStatus a owl:NamedIndividual ; fin:canonicalName "product.etp_distribution_status" ; fin:canonicalField "product.etp_distribution_status" ; fin:conceptCategory "field" ; fin:alias "ETP 판매 상태", "etp_distribution_status", "상품판매여부" .
fin:FieldEtpTradingStatus a owl:NamedIndividual ; fin:canonicalName "product.etp_trading_status" ; fin:canonicalField "product.etp_trading_status" ; fin:conceptCategory "field" ; fin:alias "ETP 거래 상태", "etp_trading_status", "거래정지 상태" .
fin:FieldCurrentEtpSaleEligible a owl:NamedIndividual ; fin:canonicalName "product.current_etp_sale_eligible" ; fin:canonicalField "product.current_etp_sale_eligible" ; fin:conceptCategory "field" ; fin:alias "현재 ETP 구매 가능", "현재 구매 가능한 ETP", "current_etp_sale_eligible" .
fin:FieldLatestEtpPriceAvailable a owl:NamedIndividual ; fin:canonicalName "product.latest_etp_price_available" ; fin:canonicalField "product.latest_etp_price_available" ; fin:conceptCategory "field" ; fin:alias "최신 ETP 가격 있음", "최신 가격 있는 ETP", "latest_etp_price_available" .
fin:FieldEtpListingEnded a owl:NamedIndividual ; fin:canonicalName "product.etp_listing_ended" ; fin:canonicalField "product.etp_listing_ended" ; fin:conceptCategory "field" ; fin:alias "ETP 상장 종료", "상장 종료된 ETP", "etp_listing_ended" .
fin:FieldStaleEtpPriceWarning a owl:NamedIndividual ; fin:canonicalName "product.stale_etp_price_warning" ; fin:canonicalField "product.stale_etp_price_warning" ; fin:conceptCategory "field" ; fin:alias "ETP 가격 오래됨", "가격 오래된 ETP", "stale_etp_price_warning" .
fin:FieldEtpInsufficientInfo a owl:NamedIndividual ; fin:canonicalName "product.etp_insufficient_info" ; fin:canonicalField "product.etp_insufficient_info" ; fin:conceptCategory "field" ; fin:alias "ETP 정보 부족", "추천하기 어려운 ETP", "etp_insufficient_info" .
