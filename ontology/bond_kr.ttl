fin:SaleLotShape a sh:NodeShape ;
    sh:property [ sh:class fin:Bond ;
            sh:maxCount 1 ;
            sh:message "Each SaleLot must belong to exactly one Bond."@en ;
            sh:minCount 1 ;
            sh:path [ sh:inversePath fin:hasSaleLot ] ] ;
    sh:targetClass fin:SaleLot .

fin:availableThroughTradingChannel a owl:ObjectProperty ;
    rdfs:domain fin:SaleLot ;
    rdfs:range fin:TradingChannel .

fin:hasBondType a owl:ObjectProperty ;
    rdfs:domain fin:Bond ;
    rdfs:range fin:BondType .

fin:hasCreditRating a owl:ObjectProperty ;
    rdfs:domain fin:DebtSecurity ;
    rdfs:range fin:CreditRating .

fin:hasInstrumentCountry a owl:ObjectProperty ;
    rdfs:comment "Instrument-country semantics only; do not silently reinterpret as issuer country."@en ;
    rdfs:domain fin:Bond ;
    rdfs:range fin:Country .

fin:hasInterestPaymentType a owl:ObjectProperty ;
    rdfs:domain fin:Bond ;
    rdfs:range fin:InterestPaymentType .

fin:hasInterestRateType a owl:ObjectProperty ;
    rdfs:domain fin:Bond ;
    rdfs:range fin:InterestRateType .

fin:hasTradingType a owl:ObjectProperty ;
    rdfs:domain fin:SaleLot ;
    rdfs:range fin:TradingType .

fin:issueDate a owl:DatatypeProperty ;
    rdfs:domain fin:Bond ;
    rdfs:range xsd:date .

fin:lotSequence a owl:DatatypeProperty ;
    rdfs:domain fin:SaleLot ;
    rdfs:range xsd:positiveInteger .

fin:maturityOrFirstCallDate a owl:DatatypeProperty ;
    rdfs:domain fin:Bond ;
    rdfs:range xsd:date .

fin:totalIssueAmount a owl:DatatypeProperty ;
    rdfs:domain fin:Bond ;
    rdfs:range xsd:decimal .

fin:CreditRating a owl:Class ;
    rdfs:subClassOf fin:ClassificationConcept .

fin:InterestPaymentType a owl:Class ;
    rdfs:subClassOf fin:ClassificationConcept .

fin:InterestRateType a owl:Class ;
    rdfs:subClassOf fin:ClassificationConcept .

fin:TradingChannel a owl:Class ;
    rdfs:subClassOf fin:Channel .

fin:TradingType a owl:Class ;
    rdfs:subClassOf fin:ClassificationConcept .

fin:hasSaleLot a owl:ObjectProperty ;
    rdfs:domain fin:Bond ;
    rdfs:range fin:SaleLot ;
    rdfs:comment "Optional 0..N relation from a Bond to concrete sale-condition lots; absence of a SaleLot does not imply purchase ineligibility."@en .

fin:SaleLot a owl:Class ;
    rdfs:label "Bond sale lot"@en,
        "채권 판매 LOT"@ko ;
    rdfs:comment "A concrete PRBD sale-condition bundle evidenced by price, yield, channel, or sale-condition date fields. It is distinct from organizer-policy bond purchase eligibility."@en ;
    rdfs:subClassOf fin:EvidenceBearingEntity .

fin:Bond a owl:Class ;
    rdfs:label "Bond"@en,
        "채권"@ko ;
    rdfs:subClassOf fin:DebtSecurity ;
    fin:alias "채권"@ko ;
    fin:canonicalName "FinancialProduct.Bond" ;
    fin:conceptCategory "product_type" .

fin:BondType a owl:Class ;
    rdfs:subClassOf fin:ClassificationConcept .
