@prefix fin: <https://miraeasset.com/ontology/financial-product#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fin:investmentStrategyDescription a owl:DatatypeProperty ;
    rdfs:domain fin:ExchangeTradedProduct ;
    rdfs:range xsd:string .

fin:listedInCountry a owl:ObjectProperty ;
    rdfs:domain fin:ExchangeTradedProduct ;
    rdfs:range fin:Country .

fin:listedInMarket a owl:ObjectProperty ;
    rdfs:domain fin:ExchangeTradedProduct ;
    rdfs:range fin:Market .

fin:listedOnExchange a owl:ObjectProperty ;
    rdfs:domain fin:ExchangeTradedProduct ;
    rdfs:range fin:Exchange .

fin:tradedInCurrency a owl:ObjectProperty ;
    rdfs:domain fin:ExchangeTradedProduct ;
    rdfs:range fin:Currency .

fin:Exchange a owl:Class ;
    rdfs:label "Exchange"@en,
        "거래소"@ko ;
    rdfs:subClassOf fin:SemanticEntity .

fin:Market a owl:Class ;
    rdfs:label "Market"@en,
        "시장"@ko ;
    rdfs:subClassOf fin:SemanticEntity .
