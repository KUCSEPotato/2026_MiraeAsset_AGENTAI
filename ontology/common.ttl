fin:hasOfferingType a owl:ObjectProperty ;
    rdfs:range fin:OfferingType .

fin:hasRiskGrade a owl:ObjectProperty ;
    rdfs:range fin:RiskGrade .

fin:issuedBy a owl:ObjectProperty ;
    rdfs:comment "Used for ETN and Bond issuer roles."@en ;
    rdfs:range fin:Organization ;
    fin:alias "발행사"@ko,
        "발행한"@ko ;
    fin:canonicalName "issuedBy" ;
    fin:conceptCategory "relation" .

fin:managedBy a owl:ObjectProperty ;
    rdfs:comment "Used for ETF and Fund management roles."@en ;
    rdfs:range fin:Organization ;
    fin:alias "운용사"@ko,
        "운용하는"@ko ;
    fin:canonicalName "managedBy" ;
    fin:conceptCategory "relation" .

