fin:INVALID_FORMAT a fin:ValidationStatus ;
    skos:prefLabel "Invalid format"@en .

fin:ISIN a fin:IdentifierScheme ;
    skos:prefLabel "ISIN"@en .

fin:ISINIdentifierShape a sh:NodeShape ;
    sh:property [ sh:flags "i" ;
            sh:message "ISIN identifierValue must match the ISIN format."@en ;
            sh:path fin:identifierValue ;
            sh:pattern "^[A-Z]{2}[A-Z0-9]{9}[0-9]$" ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """
            SELECT ?this WHERE {
                ?this fin:identifierScheme fin:ISIN .
            }
        """ ] .

fin:IdentifierCollisionShape a sh:NodeShape ;
    sh:sparql [ sh:message "The same identifier scheme, namespace, and value is connected to different products."@en ;
            sh:select """
            SELECT $this WHERE {
                $this fin:identifierScheme ?scheme ;
                      fin:identifierValue ?value ;
                      fin:identifierNamespace ?namespace .
                ?p1 fin:hasIdentifier $this .
                ?other fin:identifierScheme ?scheme ;
                       fin:identifierValue ?value ;
                       fin:identifierNamespace ?namespace .
                ?p2 fin:hasIdentifier ?other .
                FILTER ($this != ?other && ?p1 != ?p2)
            }
        """ ] ;
    sh:targetClass fin:Identifier .

fin:IdentifierShape a sh:NodeShape ;
    sh:property [ sh:class fin:IdentifierScheme ;
            sh:maxCount 1 ;
            sh:message "Identifier must have exactly one identifierScheme."@en ;
            sh:minCount 1 ;
            sh:path fin:identifierScheme ],
        [ sh:datatype xsd:string ;
            sh:in ( "VALIDATED" "FORMAT_ONLY" "UNKNOWN_VALIDATION" "CONFLICT" "INVALID_FORMAT" ) ;
            sh:maxCount 1 ;
            sh:message "Identifier must have a supported validationStatus."@en ;
            sh:minCount 1 ;
            sh:path fin:validationStatus ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Identifier must have exactly one non-empty identifierValue."@en ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path fin:identifierValue ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Identifier must have exactly one non-empty identifierNamespace."@en ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path fin:identifierNamespace ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path fin:isPrimaryInSource ] ;
    sh:targetClass fin:Identifier .

