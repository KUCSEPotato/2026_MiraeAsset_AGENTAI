fin:hasIdentifier a owl:ObjectProperty ;
    rdfs:domain fin:SemanticEntity ;
    rdfs:range fin:Identifier .

fin:holds a owl:ObjectProperty ;
    rdfs:comment "Temporal holding fact whose effective date and evidence are stored in the canonical fact model."@en ;
    rdfs:domain fin:FinancialProduct ;
    rdfs:range fin:Security ;
    fin:alias "보유"@ko,
        "보유한"@ko ;
    fin:canonicalName "holds" ;
    fin:conceptCategory "relation" .

fin:identifierValue a owl:DatatypeProperty ;
    rdfs:domain fin:Identifier ;
    rdfs:range xsd:string .

fin:OfferingType a owl:Class ;
