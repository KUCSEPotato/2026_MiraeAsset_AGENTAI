fin:SecurityIssuerRelationShape a sh:NodeShape ;
    sh:class fin:Security ;
    sh:property [ sh:class fin:Organization ;
            sh:message "securityIssuedBy must connect Security to Organization."@en ;
            sh:path fin:securityIssuedBy ] ;
    sh:targetSubjectsOf fin:securityIssuedBy .

fin:SecurityShape a sh:NodeShape ;
    sh:property [ sh:class fin:Identifier ;
            sh:message "A canonical Security requires authoritative identifier evidence."@en ;
            sh:minCount 1 ;
            sh:path fin:hasIdentifier ],
        [ sh:class fin:Organization ;
            sh:maxCount 1 ;
            sh:message "Security issuer identity is optional but must be a proven Organization when asserted."@en ;
            sh:path fin:securityIssuedBy ] ;
    sh:targetClass fin:Security .

fin:SizeMetric a fin:MetricFamily ;
    fin:primaryStore fin:RDBStore ;
    fin:semanticKey "aum",
        "netAssets",
        "outstandingAmount" .

fin:SourceRecordShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:path fin:snapshotDate ],
        [ sh:class fin:EvidenceBearingEntity ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path fin:describesEntity ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path fin:sourcePrimaryKey ],
        [ sh:datatype xsd:positiveInteger ;
            sh:maxCount 1 ;
            sh:path fin:sourceRowNumber ],
        [ sh:class fin:SourceDataset ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path fin:inDataset ] ;
    sh:targetClass fin:SourceRecord .

