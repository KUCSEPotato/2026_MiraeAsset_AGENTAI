fin:identifierNamespace a owl:DatatypeProperty ;
    rdfs:domain fin:Identifier ;
    rdfs:range xsd:string .

fin:identifierScheme a owl:ObjectProperty ;
    rdfs:domain fin:Identifier ;
    rdfs:range fin:IdentifierScheme .

fin:inDataset a owl:ObjectProperty ;
    rdfs:domain fin:SourceRecord ;
    rdfs:range fin:SourceDataset .

