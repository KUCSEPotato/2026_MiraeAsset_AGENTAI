    rdfs:subClassOf fin:EvidenceBearingEntity .

fin:describesEntity a owl:ObjectProperty ;
    rdfs:comment "Exactly one primary semantic entity represented by the physical source row."@en ;
    rdfs:domain fin:SourceRecord ;
    rdfs:range fin:EvidenceBearingEntity .

fin:securityIssuedBy a owl:ObjectProperty ;
    rdfs:comment "Security-specific issuer relation; it does not broaden the product issuedBy contract."@en ;
    rdfs:domain fin:Security ;
    rdfs:range fin:Organization ;
    fin:alias "증권 발행사"@ko ;
    fin:canonicalName "securityIssuedBy" ;
    fin:conceptCategory "relation" .

fin:MarketScope a owl:Class ;
    rdfs:subClassOf fin:ClassificationConcept .

fin:QualityStatus a owl:Class ;
    rdfs:subClassOf fin:ClassificationConcept ;
