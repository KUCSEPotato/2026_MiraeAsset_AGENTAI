    rdfs:comment "Additional semantic entity supported by the same source row; field-level evidence remains separately asserted."@en ;
    rdfs:domain fin:SourceRecord ;
    rdfs:range fin:EvidenceBearingEntity .

fin:uncertaintyNote a owl:DatatypeProperty ;
    rdfs:range xsd:string .

