    fin:primaryStore fin:RDBStore ;
    fin:semanticKey "volatility.1M",
        "volatility.1Y",
        "volatility.3M",
        "volatility.6M" .

fin:YieldMetric a fin:MetricFamily ;
    fin:primaryStore fin:RDBStore ;
    fin:semanticKey "afterTaxYield",
        "buyYield",
        "corporateYield" .

