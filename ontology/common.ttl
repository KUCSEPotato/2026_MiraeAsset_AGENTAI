fin:HoldsRelationShape a sh:NodeShape ;
    sh:class fin:FinancialProduct ;
    sh:property [ sh:class fin:Security ;
            sh:message "HOLDS must connect FinancialProduct to Security, never directly to Organization."@en ;
            sh:path fin:holds ] ;
