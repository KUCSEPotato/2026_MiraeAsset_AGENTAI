fin:onFailureStatus a owl:ObjectProperty ;
    rdfs:domain fin:OperationalConstraint ;
    rdfs:range fin:AnswerStatus .

fin:primaryStore a owl:ObjectProperty ;
    rdfs:domain fin:MetricFamily ;
    rdfs:range fin:RuntimeStore .

fin:qualityStatus a owl:DatatypeProperty ;
    rdfs:comment "Lexical code matching the local name of a fin:QualityStatus individual."@en ;
    rdfs:range xsd:string .

fin:rawPayloadHash a owl:DatatypeProperty ;
    rdfs:domain fin:SourceRecord ;
